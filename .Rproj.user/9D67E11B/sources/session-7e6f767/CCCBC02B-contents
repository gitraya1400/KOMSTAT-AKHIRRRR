        cat("=================\n")
        cat("Variabel:", input$onesample_variable, "\n")
        cat("H0: μ =", input$mu_hypothesis, "\n")
        cat("H1: μ", input$alternative_hypothesis, input$mu_hypothesis, "\n\n")
        
        if(input$onesample_group == "none") {
          test_result <- t.test(var_data, mu = input$mu_hypothesis, alternative = input$alternative_hypothesis)
          
          cat("Sample mean:", round(test_result$estimate, 4), "\n")
          cat("t =", round(test_result$statistic, 4), "\n")
          cat("df =", test_result$parameter, "\n")
          cat("p-value =", format.pval(test_result$p.value), "\n")
          cat("95% CI: [", round(test_result$conf.int[1], 4), ",", round(test_result$conf.int[2], 4), "]\n")
          cat("\nKesimpulan:", ifelse(test_result$p.value < 0.05, "Tolak H0", "Gagal tolak H0"), "\n")
        } else {
          group_data <- sovi_data[[input$onesample_group]]
          groups <- unique(group_data)
          
          for(group in groups) {
            group_values <- var_data[group_data == group]
            test_result <- t.test(group_values, mu = input$mu_hypothesis, alternative = input$alternative_hypothesis)
            
            cat("Kelompok:", group, "\n")
            cat("n =", length(group_values), "\n")
            cat("Sample mean:", round(test_result$estimate, 4), "\n")
