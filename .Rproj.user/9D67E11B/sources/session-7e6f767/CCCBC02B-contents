            scale_fill_manual(values = colors[1:length(unique(group_data))]) +
            labs(title = paste("Histogram by Group -", input$normality_variable),
                 x = input$normality_variable, y = "Density") +
            theme_minimal()
        }
        
        ggplotly(p) %>% config(displayModeBar = FALSE)
      })
      
      output$normality_interpretation <- renderUI({
        interpretation <- paste0(
          "Uji normalitas menggunakan ", input$normality_test, " untuk variabel ", input$normality_variable, 
          if(input$normality_group != "none") paste(" berdasarkan kelompok", input$normality_group) else "", ". ",
          "Hipotesis nol (H0) menyatakan bahwa data berdistribusi normal. ",
          "Jika p-value < 0.05, maka H0 ditolak yang berarti data tidak berdistribusi normal. ",
          "Q-Q plot membantu visualisasi normalitas - titik-titik yang mengikuti garis diagonal menunjukkan distribusi normal. ",
          "Histogram dengan kurva normal overlay memberikan gambaran visual tentang kesesuaian distribusi data dengan distribusi normal. ",
          "Asumsi normalitas penting untuk analisis statistik parametrik seperti uji t, ANOVA, dan regresi linear."
        )
        
        HTML(interpretation)
      })
    })
    
