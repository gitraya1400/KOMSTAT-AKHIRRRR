      }
      
      output$normality_result <- renderPrint({
        cat("Uji Normalitas -", input$normality_test, "\n")
        cat("=====================================\n")
        cat("Variabel:", input$normality_variable, "\n")
        cat("Kelompok:", group_label, "\n\n")
        
        if(input$normality_group == "none") {
          if(input$normality_test == "shapiro") {
            if(length(test_data) <= 5000) {
              test_result <- shapiro.test(test_data)
              cat("Shapiro-Wilk Test:\n")
              cat("W =", round(test_result$statistic, 4), "\n")
              cat("p-value =", format.pval(test_result$p.value), "\n")
            } else {
              cat("Data terlalu besar untuk Shapiro-Wilk test (n > 5000)\n")
            }
          } else if(input$normality_test == "anderson") {
            test_result <- ad.test(test_data)
            cat("Anderson-Darling Test:\n")
            cat("A =", round(test_result$statistic, 4), "\n")
            cat("p-value =", format.pval(test_result$p.value), "\n")
          } else if(input$normality_test == "ks") {
            test_result <- ks.test(test_data, "pnorm", mean(test_data, na.rm = TRUE), sd(test_data, na.rm = TRUE))
            cat("Kolmogorov-Smirnov Test:\n")
            cat("D =", round(test_result$statistic, 4), "\n")
            cat("p-value =", format.pval(test_result$p.value), "\n")
          } else if(input$normality_test == "jarque") {
            test_result <- jarque.bera.test(test_data)
            cat("Jarque-Bera Test:\n")
            cat("JB =", round(test_result$statistic, 4), "\n")
            cat("p-value =", format.pval(test_result$p.value), "\n")
          }
          
          cat("\nKesimpulan:", ifelse(test_result$p.value < 0.05, "Tolak H0 (Data tidak normal)", "Gagal tolak H0 (Data normal)"), "\n")
        } else {
          for(i in 1:length(test_data)) {
            group_name <- names(test_data)[i]
            group_values <- test_data[[i]]
            
            cat("Kelompok:", group_name, "\n")
            cat("n =", length(group_values), "\n")
            
            if(input$normality_test == "shapiro" && length(group_values) <= 5000) {
              test_result <- shapiro.test(group_values)
              cat("W =", round(test_result$statistic, 4), ", p-value =", format.pval(test_result$p.value), "\n")
            } else if(input$normality_test == "anderson") {
              test_result <- ad.test(group_values)
              cat("A =", round(test_result$statistic, 4), ", p-value =", format.pval(test_result$p.value), "\n")
            }
            
            cat("Kesimpulan:", ifelse(test_result$p.value < 0.05, "Tidak normal", "Normal"), "\n\n")
          }
        }
      })
      
