        interpretation <- paste0(interpretation, 
                                 "Plot interaksi menunjukkan pola hubungan antara faktor-faktor. ",
                                 "Garis yang tidak paralel mengindikasikan adanya interaksi.")
        
        HTML(interpretation)
      })
    })
    
    # Multiple regression
    observeEvent(input$run_regression, {
      req(input$regression_response, input$regression_predictors)
      
      if(length(input$regression_predictors) < 1) {
        showNotification("Pilih minimal 1 variabel prediktor.", type = "warning")
        return()
      }
      
      # Prepare data
      regression_data <- sovi_data[, c(input$regression_response, input$regression_predictors), drop = FALSE]
      regression_data <- na.omit(regression_data)
      
      # Create formula
      formula_str <- paste(input$regression_response, "~", paste(input$regression_predictors, collapse = " + "))
      
      # Fit model
      model <- lm(as.formula(formula_str), data = regression_data)
      values$regression_model <- model
      
      output$regression_result <- renderPrint({
        cat("Regresi Linear Berganda\n")
        cat("=======================\n")
        cat("Formula:", formula_str, "\n")
        cat("n =", nrow(regression_data), "\n\n")
        
        summary(model)
      })
      
      output$model_summary <- renderPrint({
        cat("Ringkasan Model\n")
        cat("===============\n")
        cat("R-squared:", round(summary(model)$r.squared, 4), "\n")
        cat("Adjusted R-squared:", round(summary(model)$adj.r.squared, 4), "\n")
        cat("F-statistic:", round(summary(model)$fstatistic[1], 4), "\n")
        cat("p-value:", format.pval(pf(summary(model)$fstatistic[1], 
                                       summary(model)$fstatistic[2], 
                                       summary(model)$fstatistic[3], 
                                       lower.tail = FALSE)), "\n")
        cat("Residual standard error:", round(summary(model)$sigma, 4), "\n")
        cat("Degrees of freedom:", summary(model)$df[2], "\n")
      })
      
      output$fitted_actual_plot <- renderPlotly({
        fitted_values <- fitted(model)
        actual_values <- regression_data[[input$regression_response]]
        
        plot_data <- data.frame(
          fitted = fitted_values,
          actual = actual_values
        )
        
        p <- ggplot(plot_data, aes(x = fitted, y = actual)) +
          geom_point(color = colors[1], alpha = 0.6) +
          geom_abline(slope = 1, intercept = 0, color = colors[2], linewidth = 1) +
          labs(title = "Fitted vs Actual Values",
               x = "Fitted Values", y = "Actual Values") +
          theme_minimal()
        
        ggplotly(p) %>% config(displayModeBar = FALSE)
      })
      
      output$regression_interpretation <- renderUI({
        model_summary <- summary(model)
        r_squared <- round(model_summary$r.squared, 4)
        adj_r_squared <- round(model_summary$adj.r.squared, 4)
        f_stat <- round(model_summary$fstatistic[1], 4)
        p_value <- pf(model_summary$fstatistic[1], model_summary$fstatistic[2], model_summary$fstatistic[3], lower.tail = FALSE)
        
        # Count significant predictors
        coef_p_values <- model_summary$coefficients[, "Pr(>|t|)"]
        sig_predictors <- sum(coef_p_values[-1] < 0.05, na.rm = TRUE)  # Exclude intercept
        
        interpretation <- paste0(
          "Model regresi linear berganda menjelaskan ", round(r_squared * 100, 2), "% variasi dalam ", input$regression_response, 
          " (R² = ", r_squared, ", Adjusted R² = ", adj_r_squared, "). ",
          "F-statistic = ", f_stat, " dengan p-value = ", format.pval(p_value), 
          if(p_value < 0.05) " menunjukkan model secara keseluruhan signifikan." else " menunjukkan model tidak signifikan.", " ",
          "Dari ", length(input$regression_predictors), " prediktor, ", sig_predictors, " variabel signifikan pada α = 0.05. ",
          "Plot fitted vs actual values menunjukkan seberapa baik model memprediksi nilai observasi. ",
          "Titik-titik yang mendekati garis diagonal menunjukkan prediksi yang akurat."
        )
        
        HTML(interpretation)
      })
    })
    
    # Diagnostic plots
    output$residuals_fitted <- renderPlotly({
      req(values$regression_model)
      
      fitted_values <- fitted(values$regression_model)
      residuals <- residuals(values$regression_model)
      
      plot_data <- data.frame(
        fitted = fitted_values,
        residuals = residuals
      )
      
      p <- ggplot(plot_data, aes(x = fitted, y = residuals)) +
        geom_point(color = colors[1], alpha = 0.6) +
        geom_hline(yintercept = 0, color = colors[2], linewidth = 1) +
        geom_smooth(se = FALSE, color = colors[4]) +
        labs(title = "Residuals vs Fitted",
             x = "Fitted Values", y = "Residuals") +
        theme_minimal()
      
      ggplotly(p) %>% config(displayModeBar = FALSE)
    })
    
    output$qq_residuals <- renderPlotly({
      req(values$regression_model)
      
      residuals <- residuals(values$regression_model)
      
      qq_data <- data.frame(
        sample = sort(residuals),
        theoretical = qnorm(ppoints(length(residuals)))
      )
      
      p <- ggplot(qq_data, aes(x = theoretical, y = sample)) +
        geom_point(color = colors[1], alpha =0.6) +
        geom_abline(slope = sd(residuals), intercept = mean(residuals), color = colors[2], linewidth = 1) +
        labs(title = "Q-Q Plot of Residuals",
             x = "Theoretical Quantiles", y = "Sample Quantiles") +
        theme_minimal()
      
      ggplotly(p) %>% config(displayModeBar = FALSE)
    })
    
    output$scale_location_plot <- renderPlotly({
      req(values$regression_model)
      
      fitted_values <- fitted(values$regression_model)
      sqrt_abs_residuals <- sqrt(abs(residuals(values$regression_model)))
      
      plot_data <- data.frame(
        fitted = fitted_values,
        sqrt_abs_residuals = sqrt_abs_residuals
      )
      
      p <- ggplot(plot_data, aes(x = fitted, y = sqrt_abs_residuals)) +
        geom_point(color = colors[1], alpha = 0.6) +
        geom_smooth(se = FALSE, color = colors[4]) +
        labs(title = "Scale-Location Plot",
             x = "Fitted Values", y = "√|Residuals|") +
        theme_minimal()
      
      ggplotly(p) %>% config(displayModeBar = FALSE)
    })
    
    output$leverage_plot <- renderPlotly({
      req(values$regression_model)
      
      leverage <- hatvalues(values$regression_model)
      residuals <- residuals(values$regression_model)
      
      plot_data <- data.frame(
        leverage = leverage,
        residuals = residuals
      )
      
      p <- ggplot(plot_data, aes(x = leverage, y = residuals)) +
        geom_point(color = colors[1], alpha = 0.6) +
        geom_hline(yintercept = 0, color = colors[2], linewidth = 1) +
        geom_smooth(se = FALSE, color = colors[4]) +
        labs(title = "Residuals vs Leverage",
             x = "Leverage", y = "Residuals") +
        theme_minimal()
      
      ggplotly(p) %>% config(displayModeBar = FALSE)
    })
    
    output$diagnostic_interpretation <- renderUI({
      interpretation <- paste0(
        "Plot diagnostik regresi membantu mengevaluasi asumsi model: ",
        "1) Residuals vs Fitted: Pola acak menunjukkan linearitas dan homoskedastisitas yang baik. ",
        "2) Q-Q Plot: Titik-titik mengikuti garis diagonal menunjukkan normalitas residual. ",
        "3) Scale-Location: Garis horizontal menunjukkan homoskedastisitas (varians konstan). ",
        "4) Residuals vs Leverage: Mengidentifikasi outlier dan influential points. ",
        "Pelanggaran asumsi dapat memerlukan transformasi data atau metode regresi alternatif."
      )
      
      HTML(interpretation)
    })
    
    # Assumption tests for regression
    output$multicollinearity_test <- renderPrint({
      req(values$regression_model)
      
      cat("Uji Multikolinearitas (VIF)\n")
      cat("===========================\n")
      
      if(length(input$regression_predictors) > 1) {
        vif_values <- vif(values$regression_model)
        cat("Variance Inflation Factors:\n")
        for(i in 1:length(vif_values)) {
          cat(names(vif_values)[i], ":", round(vif_values[i], 3), "\n")
        }
        
        cat("\nInterpretasi:\n")
        cat("VIF < 5: Tidak ada multikolinearitas\n")
        cat("5 ≤ VIF < 10: Multikolinearitas sedang\n")
        cat("VIF ≥ 10: Multikolinearitas tinggi\n")
        
        high_vif <- names(vif_values)[vif_values >= 10]
        if(length(high_vif) > 0) {
          cat("\nVariabel dengan VIF tinggi:", paste(high_vif, collapse = ", "), "\n")
        }
      } else {
        cat("VIF tidak dapat dihitung untuk model dengan satu prediktor.\n")
      }
    })
    
    output$durbin_watson_test <- renderPrint({
      req(values$regression_model)
      
      cat("Uji Durbin-Watson (Autokorelasi)\n")
      cat("================================\n")
      
      dw_test <- durbinWatsonTest(values$regression_model)
      cat("Durbin-Watson statistic:", round(dw_test$dw, 4), "\n")
      cat("p-value:", format.pval(dw_test$p), "\n")
      
      cat("\nInterpretasi:\n")
      cat("DW ≈ 2: Tidak ada autokorelasi\n")
      cat("DW < 2: Autokorelasi positif\n")
      cat("DW > 2: Autokorelasi negatif\n")
      cat("p-value < 0.05: Ada autokorelasi signifikan\n")
    })
    
    output$residual_normality_test <- renderPrint({
      req(values$regression_model)
      
      cat("Uji Normalitas Residual\n")
      cat("=======================\n")
      
      residuals <- residuals(values$regression_model)
      
      # Shapiro-Wilk test
      if(length(residuals) <= 5000) {
        shapiro_test <- shapiro.test(residuals)
        cat("Shapiro-Wilk Test:\n")
        cat("W =", round(shapiro_test$statistic, 4), "\n")
        cat("p-value =", format.pval(shapiro_test$p.value), "\n")
      } else {
        cat("Data terlalu besar untuk Shapiro-Wilk test.\n")
      }
      
      # Anderson-Darling test
      ad_test <- ad.test(residuals)
      cat("\nAnderson-Darling Test:\n")
      cat("A =", round(ad_test$statistic, 4), "\n")
      cat("p-value =", format.pval(ad_test$p.value), "\n")
      
      cat("\nKesimpulan: Residual", 
          ifelse(ad_test$p.value < 0.05, "tidak berdistribusi normal", "berdistribusi normal"), "\n")
    })
    
    output$homoscedasticity_test <- renderPrint({
      req(values$regression_model)
      
      cat("Uji Homoskedastisitas (Breusch-Pagan)\n")
      cat("=====================================\n")
      
      # Breusch-Pagan test
      fitted_values <- fitted(values$regression_model)
      residuals_sq <- residuals(values$regression_model)^2
      
      bp_model <- lm(residuals_sq ~ fitted_values)
      bp_stat <- summary(bp_model)$fstatistic[1]
      bp_p <- pf(bp_stat, summary(bp_model)$fstatistic[2], summary(bp_model)$fstatistic[3], lower.tail = FALSE)
      
      cat("Breusch-Pagan statistic:", round(bp_stat, 4), "\n")
      cat("p-value:", format.pval(bp_p), "\n")
      
      cat("\nKesimpulan:", 
          ifelse(bp_p < 0.05, "Ada heteroskedastisitas (varians tidak konstan)", "Homoskedastisitas (varians konstan)"), "\n")
    })
    
    output$assumption_interpretation <- renderUI({
      interpretation <- paste0(
        "Uji asumsi regresi mengevaluasi validitas model: ",
        "1) Multikolinearitas: VIF > 10 menunjukkan korelasi tinggi antar prediktor yang dapat mengganggu interpretasi koefisien. ",
        "2) Autokorelasi: Durbin-Watson test menguji independensi residual - penting untuk data time series. ",
        "3) Normalitas residual: Diperlukan untuk validitas uji signifikansi dan confidence interval. ",
        "4) Homoskedastisitas: Varians residual yang konstan diperlukan untuk efisiensi estimator dan validitas standard error. ",
        "Pelanggaran asumsi dapat diatasi dengan transformasi data, robust standard errors, atau metode regresi alternatif."
      )
      
      HTML(interpretation)
    })
    
    # Download handlers would go here - simplified for brevity
    # Each download handler would create appropriate files (JPG, PDF, Word, ZIP)
    # and include the relevant plots and interpretations
    
